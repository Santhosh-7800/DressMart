<?xml version="1.0" encoding="utf-8" ?>
<!-- Debug-only manifest override (merged only into debug builds, never release) — allows cleartext
     HTTP so the app can reach a local Vite dev server / Firebase emulators for live-reload testing
     (capacitor.config.ts's `server.url`), which real devices need since they aren't exempted from
     Android's default cleartext-traffic block the way the emulator's 10.0.2.2 alias effectively is. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
