{
  "name": "dressmart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DressMart - Premium online shopping for Men's & Kids' wear",
  "scripts": {
    "predev": "tsx scripts/generateImageManifest.ts && tsx scripts/ensureSeeded.ts",
    "dev": "vite",
    "prebuild": "tsx scripts/generateImageManifest.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "seed": "tsx scripts/seedFirestore.ts",
    "seed:curated-formal-shirts": "tsx scripts/seedCuratedFormalShirts.ts",
    "seed:curated-checked-shirts": "tsx scripts/seedCuratedCheckedShirts.ts",
    "validate:checked-shirts": "tsx scripts/validateCheckedShirtImages.ts",
    "typecheck": "tsc -b --noEmit",
    "images:scan": "tsx scripts/generateImageManifest.ts",
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit=./.emulator-data"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-devtools": "^5.62.7",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase-admin": "^14.2.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
