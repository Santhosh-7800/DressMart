rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Cross-service read of the caller's own users/{uid} profile — lets a staff account (whose
    // uid never equals the store's seller_id) upload under that store's own path when they have
    // the upload_images permission. See firestore.rules' matching staffCan()/staffSellerId()
    // pattern; this is the Storage-side equivalent, since Storage rules can't share functions with
    // Firestore rules and must call across via firestore.get() instead of a plain get().
    function callerProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isActiveStaffFor(sellerId) {
      return isSignedIn() && callerProfile().role == 'staff' && callerProfile().staff_status == 'active' && callerProfile().seller_id == sellerId;
    }
    function staffCanUploadImages() {
      return firestore.get(/databases/(default)/documents/staff_permissions/$(request.auth.uid)).data.upload_images == true;
    }

    // Product photos — publicly readable, writable by the owning seller OR by a staff account
    // with the upload_images permission scoped to that same store (path-scoped by sellerId, not
    // by whoever the signed-in uploader actually is).
    match /products/{sellerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == sellerId || (isActiveStaffFor(sellerId) && staffCanUploadImages()))
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Profile avatars — publicly readable, writable only by that user.
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Seller shop branding (logo/banner) — publicly readable, writable only by that seller.
    match /shop/{sellerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == sellerId
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Head Seller-managed homepage banner images — publicly readable, writable only by that account.
    match /banners/{headSellerId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == headSellerId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Seller verification documents (GST certificate, etc.) — private, readable by the owner and
    // the Head Seller only (Head Seller read is enforced via a Cloud Function / Admin SDK signed
    // URL rather than this ruleset, since Storage rules can't call out to Firestore for role checks
    // the same way — keep uploads here scoped to the owner).
    match /seller_documents/{userId}/{allPaths=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
