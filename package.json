{
  "name": "dressmart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DressMart - Premium online shopping for Men's & Kids' wear",
  "workspaces": [
    "frontend",
    "backend/functions"
  ],
  "scripts": {
    "predev": "tsx scripts/generateImageManifest.ts && tsx scripts/ensureEmulatorRunning.ts && tsx scripts/ensureSeeded.ts",
    "dev": "npm run dev --workspace=frontend",
    "prebuild": "tsx scripts/generateImageManifest.ts",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend/functions",
    "preview": "npm run preview --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "typecheck": "npm run typecheck --workspace=frontend && npm run typecheck --workspace=backend/functions && tsc -p tsconfig.scripts.json --noEmit",
    "seed": "tsx scripts/seedFirestore.ts",
    "seed:curated-formal-shirts": "tsx scripts/seedCuratedFormalShirts.ts",
    "seed:curated-checked-shirts": "tsx scripts/seedCuratedCheckedShirts.ts",
    "seed:curated-shirts-tshirts": "tsx scripts/seedCuratedShirtsTshirts.ts",
    "seed:curated-apparel": "tsx scripts/seedCuratedApparel.ts",
    "seed:curated-kids": "tsx scripts/seedCuratedKids.ts",
    "validate:checked-shirts": "tsx scripts/validateCheckedShirtImages.ts",
    "validate:shirts-tshirts": "tsx scripts/validateShirtsTshirtsImages.ts",
    "validate:apparel": "tsx scripts/validateApparelImages.ts",
    "images:scan": "tsx scripts/generateImageManifest.ts",
    "emulators": "firebase --config database/firebase.json emulators:start --import=./.emulator-data --export-on-exit=./.emulator-data",
    "cap:sync": "npm run build --workspace=frontend && cd mobile && npx cap sync",
    "cap:open": "cd mobile && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3",
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-devtools": "^5.62.7",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase-admin": "^14.2.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
