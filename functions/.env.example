# Copy to functions/.env (git-ignored) for local emulator use.
# RAZORPAY_KEY_ID is not sensitive (it's returned to the client) but is still read as a
# functions/params value so behavior is identical locally and when deployed.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# RAZORPAY_KEY_SECRET is a Cloud Functions *secret* in production (see README for
# `firebase functions:secrets:set`). For the emulator, defineSecret() falls back to this
# .env value automatically.
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
