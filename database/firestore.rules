rules_version = '2';

// Security model summary:
// - buyer: owns their own cart/wishlist/addresses/orders/returns/exchanges/notifications/reviews.
// - seller / head_seller: owns products/inventory where seller_id == their uid; can read/update
//   only orders/returns/exchanges scoped to their own seller_id.
// - head_seller: everything a seller can do, plus full read on all sellers/products/orders, and
//   is the only role allowed to flip seller_status to 'approved'/'suspended' or write coupons /
//   platform_settings. Cross-document transitions (approving a seller_request AND flipping the
//   applicant's profile in the same operation) are done by Cloud Functions running with admin
//   privileges, not by these rules — see functions/src for reviewSellerRequest/suspendSeller.
// - staff: an employee created by (and scoped to) one Head Seller's store. Can touch
//   products/inventory/orders/returns/reviews owned by that store ONLY to the extent
//   staff_permissions/{uid} grants (add/edit/delete products, manage inventory, process orders,
//   approve returns, reply to customers) — see staffCan() below. Account lifecycle (create/
//   delete/reset password) goes through Cloud Functions exactly like sellers; permission/status
//   edits are simple enough to allow as direct Head-Seller-only Firestore writes.
//
// NOTE: this is a solid starting point, not a substitute for a security review before going to
// production — in particular, order/coupon totals here are trusted from the client on write;
// harden by moving order creation entirely into the placeOrder/verifyAndPlaceOrder Cloud Functions
// (which can run with the Admin SDK and bypass these rules) once that's wired up.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    function role() {
      return isSignedIn() ? userData().role : null;
    }
    function isSeller() {
      return isSignedIn() && (role() == 'seller' || role() == 'head_seller');
    }
    function isApprovedSeller() {
      return isSeller() && userData().seller_status == 'approved';
    }
    function isHeadSeller() {
      return isSignedIn() && role() == 'head_seller';
    }
    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }
    function isStaff() {
      return isSignedIn() && role() == 'staff';
    }
    function isActiveStaff() {
      return isStaff() && userData().staff_status == 'active';
    }
    // The Head Seller's uid a staff account was created under (Profile.seller_id) — every
    // product/order/inventory/return a staff member may touch is scoped to this id, never their
    // own uid. Denormalized onto users/{uid} at creation (see functions/src/callables/addStaff)
    // specifically so this never needs a second document read.
    function staffSellerId() {
      return userData().seller_id;
    }
    function staffPermissions() {
      return get(/databases/$(database)/documents/staff_permissions/$(uid())).data;
    }
    function staffCan(permission) {
      return isActiveStaff() && staffPermissions()[permission] == true;
    }

    // Singleton flag for the one-time Head Seller setup flow (see functions/src/callables/
    // createHeadSeller.ts) — public read so the setup page can tell whether it's already been used,
    // write-only via the Admin SDK inside that Cloud Function's transaction so the "exactly one Head
    // Seller, created once" guarantee can't be bypassed by a direct client write.
    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isHeadSeller();
      allow create: if isOwner(userId);
      // Self-service profile edits (name/phone/avatar/fcm tokens) plus the one-time buyer -> pending
      // seller application transition. Any other role/status change is Head-Seller or Function only.
      allow update: if isOwner(userId) && (
        request.resource.data.role == resource.data.role ||
        (resource.data.role == 'buyer' && request.resource.data.role == 'seller' && request.resource.data.seller_status == 'pending')
      );
      allow update: if isHeadSeller();

      // Cart is signed-in-only and lives under the owning user — see types/database.ts's CartItem.
      match /cart/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isHeadSeller();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isHeadSeller();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if (isApprovedSeller() && request.resource.data.seller_id == uid()) ||
        (staffCan('add_products') && request.resource.data.seller_id == staffSellerId());
      allow update: if isHeadSeller() ||
        (isApprovedSeller() && resource.data.seller_id == uid()) ||
        (staffCan('edit_products') && resource.data.seller_id == staffSellerId());
      allow delete: if isHeadSeller() ||
        (isApprovedSeller() && resource.data.seller_id == uid()) ||
        (staffCan('delete_products') && resource.data.seller_id == staffSellerId());
    }

    match /inventory/{productId} {
      allow read: if true;
      allow write: if isHeadSeller() ||
        (isApprovedSeller() && resource.data.seller_id == uid()) ||
        (staffCan('manage_inventory') && resource.data.seller_id == staffSellerId());
      allow create: if (isApprovedSeller() && request.resource.data.seller_id == uid()) ||
        (staffCan('add_products') && request.resource.data.seller_id == staffSellerId());
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyer_id == uid() || resource.data.seller_id == uid() || isHeadSeller() ||
        (isStaff() && resource.data.seller_id == staffSellerId()));
      allow create: if isSignedIn() && request.resource.data.buyer_id == uid();
      // Buyers may only move their own order to 'cancelled'; sellers/head-seller can advance any
      // other status field on orders they own / all orders respectively; a staff member needs the
      // update_order_status permission and is scoped to their own store's orders.
      allow update: if isHeadSeller() ||
        (isSeller() && resource.data.seller_id == uid()) ||
        (resource.data.buyer_id == uid() && request.resource.data.status == 'cancelled') ||
        (staffCan('update_order_status') && resource.data.seller_id == staffSellerId());
    }

    match /returns/{returnId} {
      allow read: if isSignedIn() && (resource.data.buyer_id == uid() || resource.data.seller_id == uid() || isHeadSeller() ||
        (isStaff() && resource.data.seller_id == staffSellerId()));
      allow create: if isSignedIn() && request.resource.data.buyer_id == uid();
      allow update: if isHeadSeller() ||
        (isSeller() && resource.data.seller_id == uid()) ||
        (staffCan('approve_returns') && resource.data.seller_id == staffSellerId());
    }

    match /exchanges/{exchangeId} {
      allow read: if isSignedIn() && (resource.data.buyer_id == uid() || resource.data.seller_id == uid() || isHeadSeller());
      allow create: if isSignedIn() && request.resource.data.buyer_id == uid();
      allow update: if isHeadSeller() || (isSeller() && resource.data.seller_id == uid());
    }

    match /wishlist/{itemId} {
      allow read, delete: if isSignedIn() && resource.data.user_id == uid();
      allow create: if isSignedIn() && request.resource.data.user_id == uid();
    }

    match /addresses/{addressId} {
      allow read, update, delete: if isSignedIn() && resource.data.user_id == uid();
      allow create: if isSignedIn() && request.resource.data.user_id == uid();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && resource.data.user_id == uid();
      // Ownership-scoped like every other write below — in practice notifications are created by
      // Cloud Functions via the Admin SDK (which bypasses rules entirely), so this only closes a
      // theoretical gap where a signed-in client could otherwise create a notification doc
      // targeting another user's user_id; it doesn't affect any real notification-creation path.
      allow create: if isSignedIn() && request.resource.data.user_id == uid();
    }

    match /seller_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.user_id == uid() || isHeadSeller());
      allow create: if isSignedIn() && request.resource.data.user_id == uid();
      allow update: if isHeadSeller();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isHeadSeller();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isHeadSeller();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.user_id == uid();
      allow update: if isSignedIn() && resource.data.user_id == uid();
      // Seller reply: the owning seller of the reviewed product (or head-seller) may update ONLY
      // the seller_reply field — the buyer-authored fields stay immutable to them.
      allow update: if isSignedIn() &&
        (isHeadSeller() ||
          get(/databases/$(database)/documents/products/$(resource.data.product_id)).data.seller_id == uid() ||
          (staffCan('reply_to_customers') && get(/databases/$(database)/documents/products/$(resource.data.product_id)).data.seller_id == staffSellerId())) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seller_reply']);
      allow delete: if isSignedIn() && resource.data.user_id == uid();
    }

    match /platform_settings/{docId} {
      allow read: if true;
      allow write: if isHeadSeller();
    }

    // Staff Management — see functions/src/callables/addStaff|removeStaff|resetStaffPassword for
    // the account-creation/deletion path (Admin SDK, bypasses these rules entirely). Direct client
    // writes here are limited to the Head Seller editing a single doc's simple fields (permissions,
    // designation, status) — never anything cross-document.
    match /staff/{staffId} {
      allow read: if isOwner(staffId) || isHeadSeller();
      allow write: if isHeadSeller();
    }

    match /staff_permissions/{staffId} {
      allow read: if isOwner(staffId) || isHeadSeller();
      allow write: if isHeadSeller();
    }

    match /staff_activity/{activityId} {
      allow read: if isHeadSeller() || (isSignedIn() && resource.data.staff_id == uid());
      allow create: if isHeadSeller() || (isActiveStaff() && request.resource.data.staff_id == uid());
    }

    // Signed-in-only personalization signals (recently viewed, category history, recent
    // searches) — see services/userActivityService.ts. Guests keep using localStorage instead,
    // so this collection never needs a "create if it's your own new doc" case; it's always the
    // owner reading/overwriting their own single doc.
    match /user_activity/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
